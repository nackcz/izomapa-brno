{
  // Zkopíruj do kořene repa jako wrangler.jsonc a doplň vlastní název a database_id (npx wrangler d1 create izomapa-hlaseni).
  "name": "moje-mesto",
  "main": "hlaseni/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./site", "binding": "ASSETS", "run_worker_first": ["/api/*", "/admin", "/admin.html"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "izomapa-hlaseni", "database_id": "DOPLŇ", "migrations_dir": "hlaseni/migrations" }
  ]
}
